<section class="rh-report-viewer section"><div class="page-width"><div class="rh-report-viewer__head"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h1>{{ section.settings.title }}</h1>{% if section.settings.intro != blank %}<p>{{ section.settings.intro }}</p>{% endif %}<a class="read-link" href="{{ section.settings.pdf_url }}">OPEN FULL REPORT ↗</a></div><div class="rh-report-viewer__frame"><iframe src="{{ section.settings.pdf_url }}#zoom=page-width" title="{{ section.settings.title | escape }}" loading="eager"></iframe></div></div></section><style>.rh-report-viewer{border-top:1px solid var(--border);padding-block:clamp(3rem,7vw,7rem)}.rh-report-viewer__head{max-width:56rem;margin-bottom:2rem}.rh-report-viewer__head .eyebrow{color:var(--gold)}.rh-report-viewer__head h1{font-size:clamp(2.8rem,6vw,6.5rem);font-weight:500;letter-spacing:-.06em;line-height:.92;margin:1rem 0}.rh-report-viewer__head p{max-width:42rem;font-size:1.05rem;line-height:1.55}.rh-report-viewer__frame{height:clamp(62rem,96vh,90rem);border:1px solid var(--border);background:#fff}.rh-report-viewer__frame iframe{width:100%;height:100%;border:0}@media(max-width:749px){.rh-report-viewer{padding-top:2rem}.rh-report-viewer__head h1{font-size:clamp(2.5rem,13vw,4.2rem)}.rh-report-viewer__frame{height:90vh}}</style>{% schema %}{"name":"Research PDF viewer","settings":[{"type":"text","id":"eyebrow","label":"Label","default":"R&H / RESEARCH PAPER / 01"},{"type":"text","id":"title","label":"Title","default":"R&H April Macro Summary"},{"type":"textarea","id":"intro","label":"Introduction","default":"A concise R&H view on the prevailing macro regime and the questions shaping the next decision."},{"type":"url","id":"pdf_url","label":"Shopify Files PDF URL"}]}{% endschema %}
