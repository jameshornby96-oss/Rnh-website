<section class="section"><div class="page-width"><div class="research-list">{% for article in blog.articles %}<article class="research-row"><div class="meta">{{ article.tags.first | default: 'Research' }}<br><span class="muted">{{ article.published_at | date: '%d.%m.%y' }}</span></div><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p><a class="read-link" href="{{ article.url }}">Read research ↗</a></article>{% else %}{% for block in section.blocks %}<article class="research-row" {{ block.shopify_attributes }}><div class="meta">{{ block.settings.category }}<br><span class="muted">{{ block.settings.date }}</span></div><h2>{{ block.settings.title }}</h2><p>{{ block.settings.description }}</p><a class="read-link" href="{{ block.settings.link }}">Read research ↗</a></article>{% endfor %}{% endfor %}</div></div></section>{% schema %}{"name":"Research archive","blocks":[{"type":"item","name":"Fallback research item","settings":[{"type":"select","id":"category","label":"Category","default":"MACRO","options":[{"value":"MACRO","label":"Macro"},{"value":"MARKETS","label":"Markets"},{"value":"RATES","label":"Rates"},{"value":"FX","label":"FX"},{"value":"COMMODITIES","label":"Commodities"},{"value":"EQUITIES","label":"Equities"},{"value":"CREDIT","label":"Credit"}]},{"type":"text","id":"date","label":"Date","default":"17.08.26"},{"type":"text","id":"title","label":"Title","default":"The price of patience"},{"type":"textarea","id":"description","label":"Description","default":"A precise perspective for the next decision."},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Research archive","blocks":[{"type":"item"},{"type":"item"},{"type":"item"}]}]}{% endschema %}