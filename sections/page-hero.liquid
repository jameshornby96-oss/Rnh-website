<section class="page-hero"><div class="page-width"><div class="eyebrow">{{ section.settings.eyebrow }}</div>{% assign page_heading = section.settings.heading | default: page.title %}{% if page.handle == 'research' %}<h1><span class="rh-page-hero__gold">Research</span>{{ page_heading | remove_first: 'Research' }}</h1>{% else %}<h1>{{ page_heading }}</h1>{% endif %}{% if section.settings.description != blank %}<p>{{ section.settings.description }}</p>{% endif %}</div></section><style>.page-hero h1 .rh-page-hero__gold{color:var(--gold);font-style:normal}</style>{% schema %}{"name":"Page hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"RH Capital / UK"},{"type":"text","id":"heading","label":"Heading (leave blank to use page title)"},{"type":"textarea","id":"description","label":"Description"}],"presets":[{"name":"Page hero"}]}{% endschema %}
