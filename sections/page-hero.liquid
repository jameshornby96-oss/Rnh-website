<section class="page-hero"><div class="page-width"><div class="eyebrow">{{ section.settings.eyebrow }}</div>{% assign page_heading = section.settings.heading | default: page.title %}{% if page.handle == 'research' %}{% assign page_heading = page_heading | replace: 'Research', '<em>Research</em>' %}{% endif %}<h1>{{ page_heading }}</h1>{% if section.settings.description != blank %}<p>{{ section.settings.description }}</p>{% endif %}</div></section><style>.page-hero h1 em{color:var(--gold);font-style:normal}</style>{% schema %}{"name":"Page hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"RH Capital / UK"},{"type":"text","id":"heading","label":"Heading (leave blank to use page title)"},{"type":"textarea","id":"description","label":"Description"}],"presets":[{"name":"Page hero"}]}{% endschema %}
