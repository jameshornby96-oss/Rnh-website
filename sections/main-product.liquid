<section class="product"><div class="product-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: alt: product.title }}{% else %}<div style="aspect-ratio:1;border:1px solid var(--border);display:grid;place-items:center" class="meta">RH / Product image</div>{% endif %}</div><div class="product-info"><div class="eyebrow">{{ product.type | default: 'R&H Intelligence' }}</div><h1>{{ product.title }}</h1><div class="price">{{ product.selected_or_first_available_variant.price | money }}</div><div class="product-description">{{ product.description }}</div>{% if section.settings.includes != blank %}<div class="product-includes"><h2>What's included</h2><p>{{ section.settings.includes }}</p></div>{% endif %}{% form 'product', product, class: 'product-form' %}{% if product.has_only_default_variant == false %}<div class="variant-picker"><label for="variant-{{ section.id }}">Select access</label><select id="variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select></div>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}<button class="button" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Add to cart ↗{% else %}Sold out{% endif %}</button>{% endform %}<p class="disclaimer">{{ section.settings.note }}</p></div></section>{% schema %}{"name":"Main product","settings":[{"type":"textarea","id":"includes","label":"What's included","default":"Research briefing\nKey charts and framework\nImmediate digital access"},{"type":"textarea","id":"note","label":"Product note","default":"Access details and delivery information are confirmed at checkout."}]}{% endschema %}
