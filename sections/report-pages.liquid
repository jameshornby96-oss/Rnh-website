<section class="rh-report-pages section">
  <div class="page-width">
    <header class="rh-report-pages__head">
      <span class="eyebrow">R&H / AI &amp; TECHNOLOGY / 01</span>
      <h1>AI: Investment Return, Hyperscalers &amp; Positioning</h1>
      <p>A complete, in-page reading version of R&amp;H Capital's AI research note from 1 September 2026.</p>
    </header>
    <div class="rh-report-pages__document">
      {% for page_number in (1..10) %}
        <figure class="rh-report-pages__page"><img src="{{ 'ai-analysis-' | append: page_number | append: '.png' | asset_url }}" loading="{% if page_number == 1 %}eager{% else %}lazy{% endif %}" alt="AI Investment Return Hyperscalers and Positioning - Page {{ page_number }}"></figure>
      {% endfor %}
    </div>
  </div>
</section>
<style>
.rh-report-pages{border-top:1px solid var(--border);padding-block:clamp(3rem,7vw,7rem)}
.rh-report-pages__head{max-width:56rem;margin-bottom:clamp(2.5rem,5vw,5rem)}
.rh-report-pages__head .eyebrow{color:var(--gold)}
.rh-report-pages__head h1{font-size:clamp(2.8rem,6vw,6.5rem);font-weight:500;letter-spacing:-.06em;line-height:.92;margin:1rem 0}
.rh-report-pages__head p{font-size:1.05rem;line-height:1.55}
.rh-report-pages__document{max-width:58rem;margin:auto}
.rh-report-pages__page{margin:0 0 2rem;border:1px solid var(--border);background:#fff;line-height:0}
.rh-report-pages__page img{display:block;width:100%;height:auto}
@media(max-width:749px){.rh-report-pages{padding-top:2rem}.rh-report-pages__head h1{font-size:clamp(2.5rem,13vw,4.2rem)}.rh-report-pages__page{margin-bottom:1rem}}
</style>
{% schema %}
{"name":"R&H AI analysis pages","settings":[]}
{% endschema %}
