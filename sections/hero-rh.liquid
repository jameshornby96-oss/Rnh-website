{% liquid
  assign portfolio_link = section.settings.portfolio_link | default: '/pages/portfolio'
  assign first_link = section.settings.primary_link | default: '/pages/research?view=research'
  assign newsletter_link = section.settings.secondary_link | default: '/pages/r-h-intelligence?view=rh-intelligence'
  assign research_link = section.settings.research_link | default: '/pages/ai-analysis'
%}
<section class="rh-home-hero" aria-labelledby="HomeHero-{{ section.id }}">
  <div class="rh-home-hero__inner page-width">
    <div class="rh-home-hero__copy">
      <p class="rh-home-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="HomeHero-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h1>
      <p class="rh-home-hero__description">{{ section.settings.description | escape | newline_to_br }}</p>
      <div class="rh-home-hero__actions">
        {% if section.settings.primary_label != blank %}<a href="{{ first_link }}">{{ section.settings.primary_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a href="{{ newsletter_link }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
      </div>
    </div>
    <div class="rh-home-hero__features">
      <a class="rh-home-feature rh-home-feature--portfolio" href="{{ portfolio_link }}">
        <span class="rh-home-feature__label">R&amp;H / LONG-TERM PORTFOLIO</span>
        <span class="rh-home-feature__title">{{ section.settings.card_title | escape }}</span>
        {% if section.settings.disclaimer != blank %}<span class="rh-home-feature__note">{{ section.settings.disclaimer | escape }}</span>{% endif %}
        <span class="rh-home-feature__link">VIEW PORTFOLIO <span aria-hidden="true">↗</span></span>
      </a>
      <a class="rh-home-feature rh-home-feature--research" href="{{ research_link }}">
        <span class="rh-home-feature__label">R&amp;H / SELECTED PAPERS</span>
        <span class="rh-home-feature__title">{{ section.settings.research_title | default: 'AI: Investment Return, Hyperscalers & Positioning' | escape }}</span>
        <span class="rh-home-feature__link">READ PAPER <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </div>
</section>
{% schema %}
{"name":"RH hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Independent finance company / UK"},{"type":"textarea","id":"heading","label":"Heading","default":"Building a\nnew\ngeneration\nof macro\nresearch."},{"type":"textarea","id":"description","label":"Description","default":"Independent market research, macroeconomic insight, and active trading experience."},{"type":"text","id":"primary_label","label":"First CTA","default":"Explore R&H"},{"type":"url","id":"primary_link","label":"First CTA link"},{"type":"text","id":"secondary_label","label":"Second CTA","default":"Join R&H Intelligence"},{"type":"url","id":"secondary_link","label":"Second CTA link"},{"type":"text","id":"card_title","label":"Portfolio label","default":"Long-term portfolio"},{"type":"text","id":"portfolio_return","label":"Portfolio return","default":"+8.2%"},{"type":"text","id":"portfolio_period","label":"Return period","default":"3 MONTHS / NET CHANGE"},{"type":"url","id":"portfolio_link","label":"Portfolio page link"},{"type":"textarea","id":"disclaimer","label":"Portfolio note","default":"Personal portfolio. Percentage return only. Excludes macro positions and short-term trading activity. Source: Robinhood account export."},{"type":"text","id":"research_title","label":"Selected paper title","default":"AI: Investment Return, Hyperscalers & Positioning"},{"type":"url","id":"research_link","label":"Selected paper link"}],"presets":[{"name":"RH hero"}]}
{% endschema %}
