{% assign hero_heading = section.settings.heading | newline_to_br | replace: 'generation', '<em>generation</em>' %}<section class="hero"><div class="hero-copy reveal"><div><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1>{{ hero_heading }}</h1></div><div class="hero-bottom"><p class="hero-description">{{ section.settings.description }}</p><div class="hero-actions"><a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }} ↗</a><a class="button button--gold" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }} ↗</a></div></div></div><div class="hero-visual"><div class="index-card reveal"><div class="index-card-top"><span class="eyebrow">R&H / Research Index</span><span class="live eyebrow">Live / Internal</span></div><h2>{{ section.settings.card_title }}</h2><div class="chart"><svg viewBox="0 0 600 250" preserveAspectRatio="none" aria-hidden="true"><path class="area" d="M0 220 L65 205 L125 210 L185 167 L245 181 L310 140 L370 154 L430 92 L490 112 L545 42 L600 24 V250 H0 Z"/><path class="line" d="M0 220 L65 205 L125 210 L185 167 L245 181 L310 140 L370 154 L430 92 L490 112 L545 42 L600 24"/><circle class="endpoint" cx="600" cy="24" r="5"/></svg></div><div class="chart-labels meta"><span>01 / thesis</span><span>04 / decision</span><span>08 / review</span></div><p class="disclaimer">{{ section.settings.disclaimer }}</p></div></div></section>
{% schema %}{"name":"RH hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Independent finance company / UK"},{"type":"textarea","id":"heading","label":"Heading","default":"Building a\nnew\ngeneration\nof macro\nresearch."},{"type":"textarea","id":"description","label":"Description","default":"Independent market research, macroeconomic insight, and active trading experience."},{"type":"text","id":"primary_label","label":"First CTA","default":"Explore R&H"},{"type":"url","id":"primary_link","label":"First CTA link"},{"type":"text","id":"secondary_label","label":"Second CTA","default":"Join R&H Intelligence"},{"type":"url","id":"secondary_link","label":"Second CTA link"},{"type":"text","id":"card_title","label":"Chart title","default":"Process over prediction"},{"type":"textarea","id":"disclaimer","label":"Disclaimer","default":"Illustrative internal framework. Not a performance record, forecast, or investment recommendation."}],"presets":[{"name":"RH hero"}]}{% endschema %}
