{% liquid
  assign hero_heading = section.settings.heading | newline_to_br | replace: 'Building', '<em>Building</em>' | replace: 'generation', '<em>generation</em>' | replace: 'macro', '<em>macro</em>'
  assign portfolio_link = section.settings.portfolio_link | default: '/pages/portfolio'
%}
<section class="hero">
  <div class="hero-copy reveal">
    <div>
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h1>{{ hero_heading }}</h1>
    </div>
    <div class="hero-bottom">
      <p class="hero-description">{{ section.settings.description }}</p>
      <div class="hero-actions"><a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }} ↗</a><a class="button button--gold" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }} ↗</a></div>
    </div>
  </div>
  <div class="hero-visual">
    <a class="index-card index-card--portfolio reveal" href="{{ portfolio_link }}" aria-label="View the long-term portfolio">
      <div class="index-card-top"><span class="eyebrow">R&H / LONG-TERM PORTFOLIO</span><span class="live eyebrow">VIEW PORTFOLIO ↗</span></div>
      <div class="portfolio-card-return"><span>{{ section.settings.card_title }}</span><strong>{{ section.settings.portfolio_return }}</strong><small>{{ section.settings.portfolio_period }}</small></div>
      <div class="chart"><svg viewBox="0 0 600 250" preserveAspectRatio="none" aria-hidden="true"><path class="line" d="M0 202 L58 202 L116 198 L170 182 L224 158 L275 112 L330 76 L383 64 L432 91 L477 119 L521 48 L556 76 L600 104"/><circle class="endpoint" cx="600" cy="104" r="5"/></svg></div>
      <div class="chart-labels meta"><span>LONG-TERM EQUITY</span><span>MACRO EXCLUDED</span><span>ROBINHOOD EXPORT</span></div>
      <p class="disclaimer">{{ section.settings.disclaimer }}</p>
    </a>
  </div>
</section>
{% schema %}
{"name":"RH hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Independent finance company / UK"},{"type":"textarea","id":"heading","label":"Heading","default":"Building a\nnew\ngeneration\nof macro\nresearch."},{"type":"textarea","id":"description","label":"Description","default":"Independent market research, macroeconomic insight, and active trading experience."},{"type":"text","id":"primary_label","label":"First CTA","default":"Explore R&H"},{"type":"url","id":"primary_link","label":"First CTA link"},{"type":"text","id":"secondary_label","label":"Second CTA","default":"Join R&H Intelligence"},{"type":"url","id":"secondary_link","label":"Second CTA link"},{"type":"text","id":"card_title","label":"Portfolio label","default":"Long-term portfolio"},{"type":"text","id":"portfolio_return","label":"Portfolio return","default":"+8.2%"},{"type":"text","id":"portfolio_period","label":"Return period","default":"3 MONTHS / NET CHANGE"},{"type":"url","id":"portfolio_link","label":"Portfolio page link"},{"type":"textarea","id":"disclaimer","label":"Portfolio note","default":"Personal portfolio. Percentage return only. Excludes macro positions and short-term trading activity. Source: Robinhood account export."}],"presets":[{"name":"RH hero"}]}
{% endschema %}
