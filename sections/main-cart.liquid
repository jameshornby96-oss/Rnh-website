<section class="page-hero"><div class="page-width"><div class="eyebrow">RH Capital / Commerce</div><h1>Cart / {{ cart.item_count }}</h1></div></section><section class="section"><div class="page-width">{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="research-list">{% for item in cart.items %}<div class="research-row"><div>{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: alt: item.title, style: 'width:100%' }}{% endif %}</div><div><h2>{{ item.product.title }}</h2><p>{{ item.variant.title }}</p></div><div><label class="meta" for="updates_{{ item.key }}">Quantity</label><input id="updates_{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><p><a class="read-link" href="{{ item.url_to_remove }}">Remove</a></p></div><div>{{ item.final_line_price | money }}</div></div>{% endfor %}</div><div class="cart-summary" style="max-width:520px;margin-left:auto;margin-top:2rem"><p><strong>Subtotal</strong><span style="float:right">{{ cart.total_price | money }}</span></p><button class="button" type="submit" name="update">Update cart</button><button class="button button--gold" type="submit" name="checkout" style="margin-top:.75rem">Checkout ↗</button></div></form>{% else %}<p class="prose">Your cart is currently empty.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore products ↗</a>{% endif %}</div></section>{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
