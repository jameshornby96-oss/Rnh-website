<section class="page-hero"><div class="page-width"><div class="eyebrow">Research / Archive</div><h1>{{ blog.title }}</h1></div></section><section class="section"><div class="page-width"><div class="research-list">{% for article in blog.articles %}<article class="research-row"><div class="meta">{{ article.tags.first | default: 'Research' }}<br>{{ article.published_at | date: '%d.%m.%y' }}</div><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p><a class="read-link" href="{{ article.url }}">Read research ↗</a></article>{% else %}<p>No published research yet.</p>{% endfor %}</div></div></section>{% schema %}{"name":"Research archive","settings":[]}{% endschema %}
