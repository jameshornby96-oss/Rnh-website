{% liquid
  assign section_id = 'ResearchCommand-' | append: section.id
%}
<section id="{{ section_id }}" class="rh-research-command section">
  <div class="page-width">
    <div class="rh-section-heading">
      <span class="eyebrow">{{ section.settings.monitor_eyebrow }}</span>
      <p>{{ section.settings.monitor_note }}</p>
    </div>
    <div class="rh-monitor" aria-label="R&H macro monitor">
      <div class="rh-monitor__bar"><span><i></i>{{ section.settings.monitor_title }}</span><small>{{ section.settings.monitor_disclaimer }}</small></div>
      <div class="rh-monitor__grid">
        <div class="rh-monitor__cell"><span>GROWTH</span><strong>{{ section.settings.growth }}</strong></div>
        <div class="rh-monitor__cell"><span>INFLATION</span><strong>{{ section.settings.inflation }}</strong></div>
        <div class="rh-monitor__cell"><span>LIQUIDITY</span><strong>{{ section.settings.liquidity }}</strong></div>
        <div class="rh-monitor__cell"><span>POLICY</span><strong>{{ section.settings.policy }}</strong></div>
      </div>
      <div class="rh-monitor__views">
        <div><span>R&H REGIME</span><strong>{{ section.settings.regime }}</strong></div>
        <div><span>RISK BIAS</span><strong>{{ section.settings.risk_bias }}</strong></div>
        <div><span>DURATION</span><strong>{{ section.settings.duration }}</strong></div>
        <div><span>USD</span><strong>{{ section.settings.usd }}</strong></div>
      </div>
      <div class="rh-monitor__tape"><span>US 10Y <b>{{ section.settings.us_10y }}</b></span><span>DXY <b>{{ section.settings.dxy }}</b></span><span>BRENT <b>{{ section.settings.brent }}</b></span><span>GOLD <b>{{ section.settings.gold }}</b></span></div>
    </div>

    <div class="rh-process-intro"><span class="eyebrow">OUR RESEARCH PROCESS</span><h2>{{ section.settings.process_heading }}</h2></div>
    <div class="rh-process">
      {% for block in section.blocks %}
        {% if block.type == 'process' %}
          <div class="rh-process__step" {{ block.shopify_attributes }}><span>{{ block.settings.number }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.detail }}</p></div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="rh-framework"><span class="eyebrow">R&H RESEARCH FRAMEWORK</span><div class="rh-framework__items">{% for block in section.blocks %}{% if block.type == 'framework' %}<div {{ block.shopify_attributes }}><span>{{ block.settings.number }}</span><strong>{{ block.settings.title }}</strong></div>{% endif %}{% endfor %}</div></div>
  </div>
</section>

<style>
#{{ section_id }}{border-top:1px solid var(--border);padding-block:clamp(4rem,9vw,10rem);background:var(--background);color:var(--foreground)}
#{{ section_id }} .rh-section-heading{display:flex;justify-content:space-between;gap:2rem;align-items:baseline;margin-bottom:1rem}#{{ section_id }} .rh-section-heading p{max-width:34rem;margin:0;font-size:.75rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
#{{ section_id }} .rh-monitor{border:1px solid var(--border);margin-bottom:clamp(5rem,10vw,11rem)}#{{ section_id }} .rh-monitor__bar,#{{ section_id }} .rh-monitor__tape{display:flex;justify-content:space-between;gap:1rem;padding:1rem 1.2rem;font-size:.68rem;letter-spacing:.1em;border-bottom:1px solid var(--border)}#{{ section_id }} .rh-monitor__bar i{display:inline-block;width:.5rem;height:.5rem;margin-right:.5rem;background:var(--gold);border-radius:50%}#{{ section_id }} .rh-monitor__bar small{font-size:inherit;color:var(--muted)}#{{ section_id }} .rh-monitor__grid,#{{ section_id }} .rh-monitor__views{display:grid;grid-template-columns:repeat(4,1fr)}#{{ section_id }} .rh-monitor__cell,#{{ section_id }} .rh-monitor__views div{min-height:8rem;padding:1.2rem;border-right:1px solid var(--border);display:flex;flex-direction:column;justify-content:space-between;gap:1rem}#{{ section_id }} .rh-monitor__cell:last-child,#{{ section_id }} .rh-monitor__views div:last-child{border-right:0}#{{ section_id }} .rh-monitor__cell{border-bottom:1px solid var(--border)}#{{ section_id }} .rh-monitor span{font-size:.68rem;letter-spacing:.11em;color:var(--muted)}#{{ section_id }} .rh-monitor strong{font-size:clamp(1.05rem,1.8vw,1.45rem);font-weight:500;line-height:1.05}#{{ section_id }} .rh-monitor__tape{border-bottom:0;justify-content:flex-start;gap:2.5rem;overflow:auto;white-space:nowrap}#{{ section_id }} .rh-monitor__tape b{font-weight:500;margin-left:.35rem}
#{{ section_id }} .rh-section-heading--split{margin-bottom:0}#{{ section_id }} .rh-current-views{border-top:1px solid var(--border);margin-bottom:clamp(5rem,10vw,11rem)}#{{ section_id }} .rh-current-view{display:grid;grid-template-columns:22% 1fr;gap:2rem;border-bottom:1px solid var(--border);padding:1.25rem 0}#{{ section_id }} .rh-current-view span{font-size:.7rem;letter-spacing:.09em;color:var(--gold)}#{{ section_id }} .rh-current-view p{margin:0;font-size:clamp(1.1rem,1.9vw,1.7rem);line-height:1.18;max-width:54rem}
#{{ section_id }} .rh-process-intro{max-width:54rem;margin-bottom:2.5rem}#{{ section_id }} .rh-process{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}#{{ section_id }} .rh-process__step{padding:1.3rem;min-height:15rem;border-right:1px solid var(--border);position:relative}#{{ section_id }} .rh-process__step:last-child{border-right:0}#{{ section_id }} .rh-process__step>span,#{{ section_id }} .rh-framework span{font-size:.72rem;color:var(--gold);letter-spacing:.1em}#{{ section_id }} .rh-process h3{font-size:1rem;letter-spacing:.02em;margin:3.5rem 0 .5rem}#{{ section_id }} .rh-process p{font-size:.78rem;line-height:1.45;margin:0;color:var(--muted)}#{{ section_id }} .rh-framework{margin-top:clamp(5rem,10vw,11rem)}#{{ section_id }} .rh-framework__items{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--border);margin-top:1rem}#{{ section_id }} .rh-framework__items div{padding:1.2rem;min-height:8rem;border-right:1px solid var(--border);border-bottom:1px solid var(--border);display:flex;flex-direction:column;justify-content:space-between}#{{ section_id }} .rh-framework__items div:last-child{border-right:0}#{{ section_id }} .rh-framework strong{font-size:1.1rem;font-weight:500}
#{{ section_id }} .rh-section-heading--split,#{{ section_id }} .rh-current-views{display:none}
@media(max-width:749px){#{{ section_id }} .rh-section-heading{display:block}#{{ section_id }} .rh-section-heading p{margin-top:.6rem}#{{ section_id }} .rh-monitor__grid,#{{ section_id }} .rh-monitor__views{grid-template-columns:repeat(2,1fr)}#{{ section_id }} .rh-monitor__cell:nth-child(2),#{{ section_id }} .rh-monitor__views div:nth-child(2){border-right:0}#{{ section_id }} .rh-monitor__cell,#{{ section_id }} .rh-monitor__views div{min-height:6.8rem}#{{ section_id }} .rh-current-view{grid-template-columns:1fr;gap:.7rem}#{{ section_id }} .rh-process{grid-template-columns:1fr}#{{ section_id }} .rh-process__step{min-height:auto;border-right:0;border-bottom:1px solid var(--border)}#{{ section_id }} .rh-process h3{margin:1rem 0 .5rem}#{{ section_id }} .rh-framework__items{grid-template-columns:repeat(2,1fr)}#{{ section_id }} .rh-framework__items div:nth-child(2){border-right:0}#{{ section_id }} .rh-framework__items div:nth-child(3){border-right:1px solid var(--border)}}
</style>

