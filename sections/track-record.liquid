<section class="rh-performance section" data-performance>
  <div class="page-width">
    <header class="rh-performance__header">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.intro }}</p>
      </div>
      <div class="rh-performance__headline">
        <span>R&H MODEL PORTFOLIO</span>
        <strong>{{ section.settings.performance_return }}</strong>
        <small>{{ section.settings.since_label }} / {{ section.settings.inception }}</small>
      </div>
    </header>
    <div class="rh-performance__controls" aria-label="Chart controls">
      <div class="rh-performance__ranges" role="group" aria-label="Timeframe">
        <button type="button" data-range="1">1M</button><button type="button" data-range="3">3M</button><button type="button" data-range="6">6M</button><button type="button" data-range="ytd">YTD</button><button type="button" data-range="12">1Y</button><button type="button" class="is-active" data-range="all">ALL</button>
      </div>
      <label class="rh-performance__series">COMPARE <select data-series><option value="both">R&H / SPX</option><option value="rh">R&H</option><option value="spx">SPX</option></select></label>
      <div class="rh-performance__mode" role="group"><button type="button" class="is-active" data-mode="return">RETURN %</button><button type="button" data-mode="value">PORTFOLIO VALUE</button></div>
    </div>
    <div class="rh-performance__chart-wrap">
      <svg class="rh-performance__chart" viewBox="0 0 900 420" preserveAspectRatio="none" role="img" aria-label="Cumulative model portfolio and S&P 500 comparison chart"></svg>
      <div class="rh-performance__tooltip" hidden></div>
    </div>
    <div class="rh-performance__legend"><span><i class="rh-line"></i>R&H MODEL PORTFOLIO</span><span><i class="spx-line"></i>{{ section.settings.benchmark_name }}</span><span>MODEL / ILLUSTRATIVE</span></div>
    <div class="rh-performance__metrics">
      <div><span>R&H RETURN</span><strong>{{ section.settings.performance_return }}</strong></div>
      <div><span>{{ section.settings.benchmark_name }}</span><strong>{{ section.settings.benchmark_return }}</strong></div>
      <div><span>OUTPERFORMANCE</span><strong data-outperformance>—</strong></div>
    </div>
    {% if section.settings.show_exposure %}
      <div class="rh-performance__exposure"><span class="eyebrow">CURRENT EXPOSURE</span><p>Add current exposures using this section's blocks. Leave this switch off when no verified exposure information is intended for publication.</p></div>
    {% endif %}
    <p class="rh-performance__disclaimer">{{ section.settings.disclaimer }}</p>
  </div>
  <script type="application/json" data-performance-data>{{ section.settings.performance_data | json }}</script>
</section>
<style>
.rh-performance{border-top:1px solid var(--border,#25231f);border-bottom:1px solid var(--border,#25231f);padding:clamp(64px,9vw,130px) 0;background:var(--background,#ece7dc);color:var(--foreground,#171612)}
.rh-performance__header{display:grid;grid-template-columns:1.5fr 1fr;gap:42px;align-items:end;border-bottom:1px solid var(--border,#25231f);padding-bottom:32px}.rh-performance h2{font-size:clamp(42px,6vw,90px);line-height:.92;letter-spacing:-.06em;margin:12px 0 20px}.rh-performance p{max-width:560px;line-height:1.45}.rh-performance__headline{text-align:right}.rh-performance__headline span,.rh-performance__headline small,.rh-performance__metrics span,.rh-performance__legend,.rh-performance__controls{font-size:11px;letter-spacing:.09em;text-transform:uppercase}.rh-performance__headline strong{display:block;font-size:clamp(42px,6vw,76px);line-height:1;margin:8px 0;color:var(--gold,#a87824)}.rh-performance__controls{display:flex;justify-content:space-between;gap:18px;align-items:center;padding:19px 0;border-bottom:1px solid var(--border,#25231f)}.rh-performance button,.rh-performance select{border:0;background:transparent;color:inherit;font:inherit;letter-spacing:inherit;cursor:pointer;padding:7px 9px}.rh-performance button.is-active{background:var(--foreground,#171612);color:var(--background,#ece7dc)}.rh-performance__series{display:flex;align-items:center;gap:8px}.rh-performance select{border-bottom:1px solid currentColor;padding:7px 0}.rh-performance__chart-wrap{position:relative;height:440px;border-bottom:1px solid var(--border,#25231f);padding:20px 0}.rh-performance__chart{width:100%;height:100%;overflow:visible}.rh-performance__tooltip{position:absolute;padding:10px;background:#171612;color:#ece7dc;font-size:11px;line-height:1.55;pointer-events:none;white-space:pre-line}.rh-performance__legend{display:flex;gap:25px;justify-content:flex-end;padding:14px 0}.rh-performance__legend i{display:inline-block;width:22px;border-top:2px solid;margin-right:7px;vertical-align:middle}.rh-performance__legend .rh-line{border-color:var(--gold,#a87824)}.rh-performance__legend .spx-line{border-color:#575149}.rh-performance__metrics{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--border,#25231f)}.rh-performance__metrics div{min-height:112px;padding:18px;border-right:1px solid var(--border,#25231f);display:flex;flex-direction:column;justify-content:space-between}.rh-performance__metrics div:last-child{border:0}.rh-performance__metrics strong{font-size:clamp(20px,2.5vw,34px)}.rh-performance__disclaimer{font-size:11px;line-height:1.5;max-width:760px;margin:24px 0 0;color:var(--muted,#59544d)}@media(max-width:749px){.rh-performance__header{grid-template-columns:1fr}.rh-performance__headline{text-align:left}.rh-performance__controls{align-items:flex-start;flex-direction:column}.rh-performance__ranges{display:flex;flex-wrap:wrap}.rh-performance__chart-wrap{height:290px}.rh-performance__legend{justify-content:flex-start;flex-wrap:wrap;gap:10px}.rh-performance__metrics{grid-template-columns:1fr 1fr}.rh-performance__metrics div:nth-child(2){border-right:0}.rh-performance__metrics div:nth-child(-n+2){border-bottom:1px solid var(--border,#25231f)}}
</style>
<script>
(function(){
  var section=document.currentScript.previousElementSibling.previousElementSibling;
  var raw=section.querySelector('[data-performance-data]').textContent;
  var data;
  try{data=JSON.parse(raw).trim().split(/\\n+/).map(function(row){var a=row.split(',');return {date:a[0],rh:Number(a[1]),spx:Number(a[2])};}).filter(function(p){return p.date&&!isNaN(p.rh)&&!isNaN(p.spx);});}catch(e){return;}
  var svg=section.querySelector('.rh-performance__chart'), tooltip=section.querySelector('.rh-performance__tooltip'), series=section.querySelector('[data-series]'), range='all', mode='return';
  var money=function(v){return '£'+Math.round(v).toLocaleString('en-GB')}, fmt=function(v){return (v>=0?'+':'')+v.toFixed(1)+'%'}, dateLabel=function(iso){var d=new Date(iso+'T00:00:00'),months=['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];return months[d.getMonth()]+' '+String(d.getFullYear()).slice(2)};
  function filtered(){var out=data.slice(),n=range==='all'?0:range==='ytd'?12:Number(range);return n?out.slice(-Math.max(n,2)):out;}
  function draw(){
    var pts=filtered(), values=[];pts.forEach(function(p){values.push(p.rh,p.spx)});var lo=Math.floor((Math.min.apply(null,values)-5)/5)*5,hi=Math.ceil((Math.max.apply(null,values)+5)/5)*5;
    if(mode==='value'){lo=(100000*(1+lo/100));hi=(100000*(1+hi/100));}
    var W=900,H=420,L=65,R=18,T=20,B=48, x=function(i){return L+i*((W-L-R)/Math.max(pts.length-1,1))}, y=function(v){if(mode==='value')v=100000*(1+v/100);return T+(hi-v)*(H-T-B)/(hi-lo)}, path=function(k){return pts.map(function(p,i){return (i?'L':'M')+x(i).toFixed(1)+' '+y(p[k]).toFixed(1)}).join(' ')};
    var g='';for(var i=0;i<5;i++){var v=lo+(hi-lo)*i/4, yy=y(v);g+='<line x1="'+L+'" x2="'+(W-R)+'" y1="'+yy+'" y2="'+yy+'" stroke="#bdb5a6" stroke-width="1" opacity=".55"/><text x="'+(L-8)+'" y="'+(yy+4)+'" text-anchor="end" font-size="11" fill="#59544d">'+(mode==='value'?money(v):fmt(v))+'</text>';}
    var tickEvery=Math.max(1,Math.ceil((pts.length-1)/5));pts.forEach(function(p,i){if(i===0||i===pts.length-1||i%tickEvery===0)g+='<text x="'+x(i)+'" y="'+(H-17)+'" text-anchor="middle" font-size="11" fill="#59544d">'+dateLabel(p.date)+'</text>';});
    var showRh=series.value!=='spx',showSpx=series.value!=='rh';
    if(showSpx)g+='<path d="'+path('spx')+'" fill="none" stroke="#575149" stroke-width="2.4"/>';if(showRh)g+='<path d="'+path('rh')+'" fill="none" stroke="#a87824" stroke-width="3"/>';svg.innerHTML=g;
    var last=pts[pts.length-1],out=last.rh-last.spx;section.querySelector('[data-outperformance]').textContent=fmt(out);
    svg.onmousemove=function(e){var r=svg.getBoundingClientRect(),i=Math.max(0,Math.min(pts.length-1,Math.round((e.clientX-r.left)/r.width*(pts.length-1)))),p=pts[i];tooltip.hidden=false;tooltip.style.left=(e.clientX-r.left+12)+'px';tooltip.style.top=(e.clientY-r.top+12)+'px';tooltip.textContent=p.date+'\\nR&H '+fmt(p.rh)+'\\nSPX '+fmt(p.spx);};svg.onmouseleave=function(){tooltip.hidden=true;};
  }
  section.querySelectorAll('[data-range]').forEach(function(b){b.onclick=function(){range=b.dataset.range;section.querySelectorAll('[data-range]').forEach(function(x){x.classList.remove('is-active')});b.classList.add('is-active');draw();};});
  section.querySelectorAll('[data-mode]').forEach(function(b){b.onclick=function(){mode=b.dataset.mode;section.querySelectorAll('[data-mode]').forEach(function(x){x.classList.remove('is-active')});b.classList.add('is-active');draw();};});series.onchange=draw;draw();
})();
</script>
{% schema %}
{"name":"Portfolio performance","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PORTFOLIO PERFORMANCE"},{"type":"text","id":"heading","label":"Heading","default":"Track record."},{"type":"textarea","id":"intro","label":"Introduction","default":"Tracking how ideas generated through the R&H research framework translate into model portfolio decisions."},{"type":"text","id":"performance_return","label":"R&H performance return","default":"+40.0%"},{"type":"text","id":"benchmark_name","label":"Benchmark name","default":"S&P 500 (SPX)"},{"type":"text","id":"benchmark_return","label":"Benchmark return","default":"+12.0%"},{"type":"text","id":"since_label","label":"Since label","default":"SINCE INCEPTION"},{"type":"text","id":"inception","label":"Inception date","default":"AUG 2025"},{"type":"textarea","id":"performance_data","label":"Performance data: date,R&H return %,SPX return %","default":"2025-08-01,0,0\\n2025-09-01,2,1\\n2025-10-01,5,2\\n2025-11-01,4,1\\n2025-12-01,8,3\\n2026-01-01,12,4\\n2026-02-01,10,2\\n2026-03-01,16,5\\n2026-04-01,21,6\\n2026-05-01,25,7\\n2026-06-01,31,9\\n2026-07-01,36,11\\n2026-08-01,40,12"},{"type":"checkbox","id":"show_exposure","label":"Show current exposure note","default":false},{"type":"textarea","id":"disclaimer","label":"Disclosure","default":"Performance shown represents the R&H research/model portfolio and is provided for informational purposes only. It does not represent client assets or investment advice. Past performance is not indicative of future results."}],"presets":[{"name":"Portfolio performance"}]}
{% endschema %}
