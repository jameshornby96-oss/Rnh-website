<section class="rh-performance section" data-rh-performance="{{ section.id }}">
  <div class="page-width">
    <div class="rh-performance__header"><span class="eyebrow">{{ section.settings.eyebrow }}</span><p>{{ section.settings.intro }}</p></div>
    <div class="rh-performance__headline">
      <div><span>R&H PERFORMANCE</span><strong data-performance-headline>{{ section.settings.performance_return }}</strong><small>{{ section.settings.since_label }}</small></div>
      <div><span>BENCHMARK</span><strong data-performance-benchmark>{{ section.settings.benchmark_return }}</strong><small>{{ section.settings.benchmark_name }}</small></div>
      <div><span>OUTPERFORMANCE</span><strong data-performance-outperformance>—</strong><small>{{ section.settings.since_label }}</small></div>
    </div>
    <div class="rh-performance__panel">
      <div class="rh-performance__toolbar"><label class="rh-performance__series-label">DISPLAY <select data-performance-series aria-label="Chart series"><option value="both">R&H / {{ section.settings.benchmark_name }}</option><option value="portfolio">R&H PORTFOLIO</option><option value="benchmark">{{ section.settings.benchmark_name }}</option></select></label><div role="group" aria-label="Performance display"><button type="button" data-performance-mode="return" class="is-active">RETURN %</button><button type="button" data-performance-mode="value">PORTFOLIO VALUE</button></div></div>
      <div class="rh-performance__chart-wrap">
        <svg viewBox="0 0 900 370" preserveAspectRatio="none" role="img" aria-label="R&H model portfolio performance compared with benchmark" data-performance-chart><g data-performance-grid></g><path data-performance-benchmark-path></path><path data-performance-portfolio-path></path><line data-performance-crosshair></line><circle data-performance-dot="portfolio"></circle><circle data-performance-dot="benchmark"></circle><g data-performance-labels></g></svg>
        <div class="rh-performance__tooltip" data-performance-tooltip hidden></div>
      </div>
      <div class="rh-performance__controls" role="group" aria-label="Performance timeframe"><button type="button" data-performance-range="1M">1M</button><button type="button" data-performance-range="3M">3M</button><button type="button" data-performance-range="6M">6M</button><button type="button" data-performance-range="YTD">YTD</button><button type="button" data-performance-range="1Y">1Y</button><button type="button" data-performance-range="ALL" class="is-active">ALL</button></div>
    </div>
    <div class="rh-performance__metrics"><div><span>R&H RETURN</span><strong data-metric="portfolio">—</strong></div><div><span>BENCHMARK</span><strong data-metric="benchmark">—</strong></div><div><span>OUTPERFORMANCE</span><strong data-metric="outperformance">—</strong></div><div><span>SINCE INCEPTION</span><strong>{{ section.settings.inception }}</strong></div></div>
    {% if section.settings.show_exposure %}<div class="rh-performance__exposure"><span class="eyebrow">CURRENT EXPOSURE</span><p>{{ section.settings.exposure_note }}</p></div>{% endif %}
    <p class="rh-performance__disclaimer">{{ section.settings.disclaimer }}</p>
    <script type="application/json" data-performance-data>{{ section.settings.performance_data | json }}</script>
  </div>
</section>
<style>
.rh-performance{border-top:1px solid var(--border);padding-block:clamp(4rem,9vw,10rem);background:var(--background);color:var(--foreground)}.rh-performance__header{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:2rem}.rh-performance__header p{max-width:38rem;margin:0;font-size:clamp(1rem,1.5vw,1.25rem);line-height:1.35}.rh-performance__headline,.rh-performance__metrics{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--border);border-bottom:0}.rh-performance__headline>div,.rh-performance__metrics>div{padding:1.2rem;border-right:1px solid var(--border);display:flex;min-height:10rem;flex-direction:column;justify-content:space-between}.rh-performance__headline>div:last-child,.rh-performance__metrics>div:last-child{border-right:0}.rh-performance span{font-size:.68rem;letter-spacing:.1em;color:var(--muted)}.rh-performance__headline strong{font-weight:500;font-size:clamp(2.6rem,5.7vw,6.8rem);letter-spacing:-.08em;line-height:.8}.rh-performance small{font-size:.68rem;letter-spacing:.09em;color:var(--gold)}.rh-performance__panel{border:1px solid var(--border);position:relative}.rh-performance__toolbar{padding:1rem 1.2rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;gap:1rem;align-items:center;font-size:.68rem;letter-spacing:.1em}.rh-performance__toolbar i{display:inline-block;width:.45rem;height:.45rem;background:var(--gold);border-radius:50%;margin-inline:.5rem}.rh-performance button{border:0;background:transparent;padding:.25rem .4rem;font:inherit;font-size:.66rem;letter-spacing:.08em;color:var(--muted);cursor:pointer}.rh-performance button.is-active{color:var(--foreground);box-shadow:inset 0 -1px var(--foreground)}.rh-performance__chart-wrap{height:clamp(18rem,42vw,34rem);position:relative;padding:1rem}.rh-performance__chart-wrap svg{width:100%;height:100%;overflow:visible}.rh-performance [data-performance-grid] line{stroke:var(--border);stroke-width:1}.rh-performance [data-performance-portfolio-path]{fill:none;stroke:var(--gold);stroke-width:3;vector-effect:non-scaling-stroke}.rh-performance [data-performance-benchmark-path]{fill:none;stroke:var(--foreground);stroke-width:1.2;opacity:.55;vector-effect:non-scaling-stroke}.rh-performance [data-performance-crosshair]{stroke:var(--foreground);stroke-width:1;opacity:0}.rh-performance [data-performance-dot]{fill:var(--background);stroke-width:2;opacity:0}.rh-performance [data-performance-dot="portfolio"]{stroke:var(--gold)}.rh-performance [data-performance-dot="benchmark"]{stroke:var(--foreground)}.rh-performance__tooltip{position:absolute;z-index:2;min-width:10rem;padding:.8rem;background:var(--foreground);color:var(--background);font-size:.72rem;line-height:1.65;pointer-events:none}.rh-performance__controls{padding:1rem 1.2rem;border-top:1px solid var(--border);display:flex;gap:.7rem}.rh-performance__metrics{grid-template-columns:repeat(4,1fr);border-top:0}.rh-performance__metrics>div{min-height:7rem}.rh-performance__metrics strong{font-size:clamp(1.3rem,2.3vw,2.2rem);letter-spacing:-.05em;font-weight:500}.rh-performance__disclaimer{font-size:.68rem;line-height:1.45;color:var(--muted);max-width:54rem;margin:1rem 0 0}.rh-performance__exposure{margin-top:2rem;border-top:1px solid var(--border);padding-top:1rem}.rh-performance__exposure p{font-size:.8rem;color:var(--muted)}@media(max-width:749px){.rh-performance__header{display:block}.rh-performance__header p{margin-top:1rem}.rh-performance__headline{grid-template-columns:1fr}.rh-performance__headline>div{border-right:0;border-bottom:1px solid var(--border);min-height:7rem}.rh-performance__metrics{grid-template-columns:1fr 1fr}.rh-performance__metrics>div:nth-child(2){border-right:0}.rh-performance__metrics>div{border-bottom:1px solid var(--border);min-height:5rem}.rh-performance__toolbar{align-items:flex-start;flex-direction:column}.rh-performance__chart-wrap{height:19rem}.rh-performance__controls{justify-content:space-between;gap:0}.rh-performance__controls button{padding-inline:.1rem}}
.rh-performance__series-label{font-size:.67rem;letter-spacing:.1em;color:var(--muted)}.rh-performance__series-label select{margin-left:.5rem;background:transparent;color:var(--foreground);border:1px solid var(--border);padding:.4rem .6rem;font:inherit;font-size:.67rem;letter-spacing:.08em}@media(max-width:749px){.rh-performance__series-label select{display:block;margin:.4rem 0 0}}
</style>
<script>
(function(){const root=document.querySelector('[data-rh-performance="{{ section.id }}"]');if(!root)return;const source=root.querySelector('[data-performance-data]');let points=[];try{points=JSON.parse(source.textContent).trim().split(/\n+/).map(line=>{const [date,portfolio,benchmark]=line.split(',');return {date,portfolio:Number(portfolio),benchmark:Number(benchmark)}}).filter(x=>x.date&&!Number.isNaN(x.portfolio)&&!Number.isNaN(x.benchmark));}catch(e){}if(!points.length)return;const svg=root.querySelector('[data-performance-chart]'), portfolioPath=root.querySelector('[data-performance-portfolio-path]'), benchmarkPath=root.querySelector('[data-performance-benchmark-path]'), grid=root.querySelector('[data-performance-grid]'), labels=root.querySelector('[data-performance-labels]'), cross=root.querySelector('[data-performance-crosshair]'), dotP=root.querySelector('[data-performance-dot="portfolio"]'), dotB=root.querySelector('[data-performance-dot="benchmark"]'), tooltip=root.querySelector('[data-performance-tooltip]');let range='ALL',mode='return',series='both',visible=points;const number=v=>(v>=0?'+':'')+v.toFixed(1)+'%';const select=()=>{const n={"1M":2,"3M":4,"6M":7,"YTD":Math.min(12,points.length),"1Y":Math.min(13,points.length),ALL:points.length}[range];visible=points.slice(-n)};const draw=()=>{select();const values=visible.flatMap(p=>[p.portfolio,p.benchmark]);const min=Math.min(0,...values)-3,max=Math.max(...values)+3,w=900,h=370,pad={l:45,r:15,t:20,b:32};const x=i=>pad.l+(w-pad.l-pad.r)*(visible.length===1?0:i/(visible.length-1));const y=v=>pad.t+(h-pad.t-pad.b)*(1-(v-min)/(max-min));const line=key=>visible.map((p,i)=>(i?'L':'M')+x(i).toFixed(1)+' '+y(p[key]).toFixed(1)).join(' ');portfolioPath.setAttribute('d',line('portfolio'));benchmarkPath.setAttribute('d',line('benchmark'));portfolioPath.style.opacity=series==='benchmark'?'0':'1';benchmarkPath.style.opacity=series==='portfolio'?'0':'.72';grid.innerHTML='';labels.innerHTML='';for(let i=0;i<4;i++){const v=min+(max-min)*i/3,yy=y(v);grid.insertAdjacentHTML('beforeend','<line x1="'+pad.l+'" x2="'+(w-pad.r)+'" y1="'+yy+'" y2="'+yy+'"/>');labels.insertAdjacentHTML('beforeend','<text x="0" y="'+(yy+4)+'" font-size="10" fill="currentColor" opacity=".55">'+number(v)+'</text>')}visible.forEach((p,i)=>{if(i===0||i===visible.length-1||i===Math.round((visible.length-1)/2))labels.insertAdjacentHTML('beforeend','<text x="'+x(i)+'" y="'+(h-5)+'" text-anchor="middle" font-size="10" fill="currentColor" opacity=".55">'+p.date.slice(5)+'</text>')});const latest=visible[visible.length-1];root.querySelectorAll('[data-metric="portfolio"]').forEach(el=>el.textContent=mode==='value'?'£'+Math.round(Number('{{ section.settings.starting_value | default: 100000 }}')*(1+latest.portfolio/100)).toLocaleString('en-GB'):number(latest.portfolio));root.querySelectorAll('[data-metric="benchmark"]').forEach(el=>el.textContent=number(latest.benchmark));root.querySelectorAll('[data-metric="outperformance"]').forEach(el=>el.textContent=number(latest.portfolio-latest.benchmark));root.querySelector('[data-performance-headline]').textContent=number(latest.portfolio);root.querySelector('[data-performance-benchmark]').textContent=number(latest.benchmark);root.querySelector('[data-performance-outperformance]').textContent=number(latest.portfolio-latest.benchmark);svg.onpointermove=e=>{const r=svg.getBoundingClientRect(),idx=Math.max(0,Math.min(visible.length-1,Math.round((e.clientX-r.left)/r.width*(visible.length-1)))),p=visible[idx],xx=x(idx);cross.setAttribute('x1',xx);cross.setAttribute('x2',xx);cross.setAttribute('y1',pad.t);cross.setAttribute('y2',h-pad.b);cross.style.opacity=1;dotP.setAttribute('cx',xx);dotP.setAttribute('cy',y(p.portfolio));dotB.setAttribute('cx',xx);dotB.setAttribute('cy',y(p.benchmark));dotP.style.opacity=dotB.style.opacity=1;tooltip.hidden=false;tooltip.innerHTML='<b>'+p.date+'</b>'+(series!=='benchmark'?'<br>R&H '+number(p.portfolio):'')+(series!=='portfolio'?'<br>{{ section.settings.benchmark_name | escape }} '+number(p.benchmark):'');tooltip.style.left=Math.min(r.width-160,Math.max(0,e.clientX-r.left+12))+'px';tooltip.style.top='18px'};svg.onpointerleave=()=>{cross.style.opacity=dotP.style.opacity=dotB.style.opacity=0;tooltip.hidden=true}};root.querySelectorAll('[data-performance-range]').forEach(b=>b.onclick=()=>{range=b.dataset.performanceRange;root.querySelectorAll('[data-performance-range]').forEach(x=>x.classList.toggle('is-active',x===b));draw()});root.querySelectorAll('[data-performance-mode]').forEach(b=>b.onclick=()=>{mode=b.dataset.performanceMode;root.querySelectorAll('[data-performance-mode]').forEach(x=>x.classList.toggle('is-active',x===b));draw()});root.querySelector('[data-performance-series]').onchange=e=>{series=e.target.value;draw()};draw()})();
</script>
{% schema %}
{"name":"Research — Portfolio performance","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PORTFOLIO PERFORMANCE"},{"type":"textarea","id":"intro","label":"Supporting text","default":"Tracking how ideas generated through the R&H research framework translate into portfolio decisions."},{"type":"text","id":"performance_return","label":"Displayed R&H performance","default":"+40.0%"},{"type":"text","id":"benchmark_name","label":"Benchmark name","default":"S&P 500 (SPX)"},{"type":"text","id":"benchmark_return","label":"Displayed benchmark return","default":"+12.0%"},{"type":"text","id":"since_label","label":"Performance period label","default":"SINCE INCEPTION"},{"type":"text","id":"inception","label":"Inception date","default":"Inception"},{"type":"text","id":"starting_value","label":"Model starting value","default":"100000"},{"type":"textarea","id":"performance_data","label":"Performance data CSV: date,portfolio %,benchmark %","default":"2025-08-01,0,0\n2025-09-01,2.2,1.1\n2025-10-01,4.8,2.5\n2025-11-01,7.4,3.1\n2025-12-01,9.0,4.0\n2026-01-01,12.5,4.6\n2026-02-01,14.2,5.1\n2026-03-01,17.8,5.8\n2026-04-01,20.4,6.4\n2026-05-01,25.1,7.2\n2026-06-01,29.7,8.5\n2026-07-01,34.2,9.7\n2026-08-01,40.0,12.0"},{"type":"checkbox","id":"show_exposure","label":"Show current exposure note","default":false},{"type":"textarea","id":"exposure_note","label":"Current exposure note","default":"Enable this section only when R&H is ready to publish current exposure information."},{"type":"textarea","id":"disclaimer","label":"Performance disclosure","default":"Performance shown represents the R&H research/model portfolio and is provided for informational purposes only. It does not represent client assets or investment advice. Past performance is not indicative of future results."}],"presets":[{"name":"Research — Portfolio performance"}]}
{% endschema %}
