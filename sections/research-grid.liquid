<section class="section"><div class="page-width"><div class="section-heading"><span class="eyebrow">{{ section.settings.label }}</span><h2>{{ section.settings.heading }}</h2></div><div class="research-grid">{% for block in section.blocks %}<article class="research-card" {{ block.shopify_attributes }}><div><div class="meta">{{ block.settings.category }} / {{ block.settings.date }}</div><h3>{{ block.settings.title }}</h3><p class="muted">{{ block.settings.description }}</p></div><a class="read-link" href="{{ block.settings.link }}">Read research ↗</a></article>{% endfor %}</div></div></section>{% schema %}{"name":"Research grid","settings":[{"type":"text","id":"label","label":"Label","default":"Latest intelligence"},{"type":"text","id":"heading","label":"Heading","default":"Research for decisions that matter."}],"blocks":[{"type":"research","name":"Research item","settings":[{"type":"select","id":"category","label":"Category","options":[{"value":"MACRO","label":"Macro"},{"value":"MARKETS","label":"Markets"},{"value":"RATES","label":"Rates"},{"value":"FX","label":"FX"},{"value":"COMMODITIES","label":"Commodities"},{"value":"EQUITIES","label":"Equities"},{"value":"CREDIT","label":"Credit"}]},{"type":"text","id":"date","label":"Date","default":"17.08.26"},{"type":"text","id":"title","label":"Title","default":"The price of patience"},{"type":"textarea","id":"description","label":"Description","default":"A measured view of the forces shaping the next decision."},{"type":"url","id":"link","label":"Article link"}]}],"presets":[{"name":"Research grid","blocks":[{"type":"research","settings":{"category":"MACRO","title":"The price of patience"}},{"type":"research","settings":{"category":"RATES","title":"Rates after the repricing"}},{"type":"research","settings":{"category":"FX","title":"Dollar discipline"}}]}]}{% endschema %}
