<section class="rh-talent section">
  <div class="page-width">
    <header class="rh-talent__head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro }}</p>{%- endif -%}
    </header>
    <div class="rh-talent__list">
      {%- for block in section.blocks -%}
        <article class="rh-talent__item" {{ block.shopify_attributes }}>
          <span class="rh-talent__number">{{ block.settings.number }}</span>
          <div>
            <span class="rh-talent__label">{{ block.settings.label }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <footer class="rh-talent__footer">
      <span class="eyebrow">{{ section.settings.closing_label }}</span>
      <p>{{ section.settings.closing_text }}</p>
      {%- if section.settings.link != blank -%}
        <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_text }} <span aria-hidden="true">↗</span></a>
      {%- endif -%}
    </footer>
  </div>
</section>
<style>
.rh-talent{padding-block:clamp(4rem,9vw,10rem);border-top:1px solid var(--border)}
.rh-talent__head{max-width:55rem;margin-bottom:clamp(3rem,7vw,7rem)}
.rh-talent__head .eyebrow,.rh-talent__label{color:var(--gold)}
.rh-talent__head h2{margin:.8rem 0 1.5rem;font-size:clamp(3rem,7vw,7rem);font-weight:500;letter-spacing:-.065em;line-height:.9}
.rh-talent__head p{max-width:42rem;font-size:clamp(1rem,1.4vw,1.25rem);line-height:1.5}
.rh-talent__list{border-top:1px solid var(--border)}
.rh-talent__item{display:grid;grid-template-columns:minmax(4rem,1fr) minmax(0,5fr);gap:1.5rem;padding:2rem 0;border-bottom:1px solid var(--border)}
.rh-talent__number{font-size:clamp(1.3rem,2vw,2rem);color:var(--gold);letter-spacing:-.04em}
.rh-talent__label{display:block;margin-bottom:.75rem;font-size:.7rem;letter-spacing:.12em}
.rh-talent h3{margin:0;font-size:clamp(1.65rem,3vw,3rem);font-weight:500;letter-spacing:-.05em;line-height:1}
.rh-talent__item p{max-width:38rem;margin:1rem 0 0;line-height:1.55}
.rh-talent__footer{max-width:55rem;margin-top:clamp(4rem,8vw,9rem)}
.rh-talent__footer .eyebrow{color:var(--gold)}
.rh-talent__footer p{margin:1rem 0 1.5rem;font-size:clamp(1.7rem,3vw,3.5rem);font-weight:500;letter-spacing:-.055em;line-height:1.02}
@media(max-width:749px){.rh-talent__item{grid-template-columns:3.5rem minmax(0,1fr);gap:1rem}.rh-talent__head h2{font-size:clamp(3rem,14vw,5rem)}}
</style>
{% schema %}
{
  "name": "Careers - What we seek",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"R&H / CAREERS"},
    {"type":"text","id":"heading","label":"Heading","default":"WHAT WE'RE LOOKING FOR"},
    {"type":"textarea","id":"intro","label":"Introduction","default":"Bright individuals with different skillsets and a genuine interest in markets."},
    {"type":"text","id":"closing_label","label":"Closing label","default":"ALWAYS OPEN TO A CONVERSATION"},
    {"type":"textarea","id":"closing_text","label":"Closing text","default":"We are always interested in meeting thoughtful people. Tell us your plan."},
    {"type":"url","id":"link","label":"Closing link"},
    {"type":"text","id":"link_text","label":"Closing link text","default":"GET IN TOUCH"}
  ],
  "blocks": [
    {"type":"quality","name":"Quality","settings":[
      {"type":"text","id":"number","label":"Number","default":"01"},
      {"type":"text","id":"label","label":"Label","default":"CAPABILITY"},
      {"type":"text","id":"title","label":"Title","default":"MODEL BUILDING"},
      {"type":"textarea","id":"description","label":"Description","default":"Turning a view into a framework that can be tested."}
    ]}
  ],
  "presets": [{"name":"Careers - What we seek","blocks":[{"type":"quality"},{"type":"quality","settings":{"number":"02","title":"QUANTITATIVE THINKING","description":"Comfort with data, probability and disciplined analysis."}},{"type":"quality","settings":{"number":"03","title":"MACRO & MARKETS","description":"Curiosity about the forces moving economies, assets and opportunities."}},{"type":"quality","settings":{"number":"04","title":"HUNGER","description":"High standards, intellectual energy and the willingness to do the work."}}]}]
}
{% endschema %}
