<aside class="cart-drawer" data-cart-drawer aria-label="Cart"><div class="cart-header"><strong>Cart / {{ cart.item_count }}</strong><button type="button" data-cart-close>Close ×</button></div>{% if cart.item_count == 0 %}<p class="muted">Your cart is empty.</p>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-items">{% for item in cart.items %}<div class="cart-item">{% if item.image %}{{ item.image | image_url: width: 160 | image_tag: alt: item.title }}{% endif %}<div><strong>{{ item.product.title }}</strong><br><small>{{ item.variant.title }}</small><br><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.title }}"></div><span>{{ item.final_line_price | money }}</span></div>{% endfor %}</div><div class="cart-summary"><p><strong>Subtotal</strong> <span style="float:right">{{ cart.total_price | money }}</span></p><button class="button" name="checkout" type="submit">Checkout ↗</button></div></form>{% endif %}</aside>
{% schema %}{"name":"Cart drawer","settings":[]}{% endschema %}
