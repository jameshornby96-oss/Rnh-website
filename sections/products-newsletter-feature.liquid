<section class="rh-newsletter-feature section">
  <div class="page-width">
    <article class="rh-newsletter-feature__panel">
      <div class="rh-newsletter-feature__copy">
        <span class="eyebrow">{{ section.settings.label }}</span>
        <p class="rh-newsletter-feature__category">{{ section.settings.category }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.description }}</p>
        <a class="text-link" href="{{ section.settings.link | default: '/pages/r-h-intelligence' }}">{{ section.settings.link_text }} <span aria-hidden="true">→</span></a>
      </div>
      <div class="rh-newsletter-feature__visual">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.heading }}{% else %}<svg viewBox="0 0 600 360" aria-label="Illustrative R&H newsletter graphic" role="img"><path d="M0 315H600M0 225H600M0 135H600M0 45H600"/><path class="rh-newsletter-feature__line" d="M0 292 C55 275 85 260 125 267 S195 230 240 236 S302 174 350 198 S432 152 468 116 S536 83 600 36"/></svg>{% endif %}</div>
    </article>
  </div>
</section>
<style>
.rh-newsletter-feature{border-top:1px solid var(--border);padding-block:clamp(4rem,9vw,10rem);background:var(--background);color:var(--foreground)}.rh-newsletter-feature__panel{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.rh-newsletter-feature__copy{padding:clamp(2rem,5vw,6rem) clamp(1.2rem,4vw,5rem) clamp(2rem,5vw,6rem) 0}.rh-newsletter-feature__category{margin:3rem 0 1rem;font-size:.7rem;letter-spacing:.1em;color:var(--gold)}.rh-newsletter-feature h2{font-size:clamp(3.2rem,6.6vw,7.8rem);letter-spacing:-.065em;line-height:.9;margin:.5rem 0 1.7rem;font-weight:500}.rh-newsletter-feature__copy>p:not(.rh-newsletter-feature__category){max-width:35rem;font-size:clamp(1.15rem,1.55vw,1.45rem);line-height:1.5}.rh-newsletter-feature .text-link{display:inline-block;margin-top:3rem;font-size:clamp(.85rem,1vw,1.05rem);letter-spacing:.12em;text-transform:uppercase;border-bottom:1px solid currentColor;padding-bottom:.55rem;color:var(--gold);font-weight:500}.rh-newsletter-feature__visual{border-left:1px solid var(--border);min-height:22rem;display:grid;place-items:center;overflow:hidden;background:color-mix(in srgb,var(--background) 92%,var(--gold))}.rh-newsletter-feature__visual img{width:100%;height:100%;object-fit:cover}.rh-newsletter-feature__visual svg{width:100%;height:100%;stroke:var(--border);fill:none}.rh-newsletter-feature__visual .rh-newsletter-feature__line{stroke:var(--gold);stroke-width:3}@media(max-width:749px){.rh-newsletter-feature__panel{grid-template-columns:1fr}.rh-newsletter-feature__copy{padding-inline:0}.rh-newsletter-feature__visual{border-left:0;border-top:1px solid var(--border);min-height:14rem}}
</style>
{% schema %}
{"name":"R&H newsletter feature","settings":[{"type":"text","id":"label","label":"Label","default":"R&H INTELLIGENCE"},{"type":"text","id":"category","label":"Category","default":"MACRO / MARKETS / RESEARCH"},{"type":"text","id":"heading","label":"Heading","default":"Our newsletters."},{"type":"textarea","id":"description","label":"Description","default":"A considered briefing on the week's macro and market developments, with a focused note on the questions that matter for your research."},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_text","label":"Link text","default":"Join free"}],"presets":[{"name":"R&H newsletter feature"}]}
{% endschema %}
