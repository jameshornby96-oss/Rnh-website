<section class="section"><div class="page-width"><div class="section-heading"><span class="eyebrow">Products / {{ collection.products_count }}</span><h1>{{ collection.title }}</h1></div>{% if collection.description != blank %}<div class="prose">{{ collection.description }}</div>{% endif %}<div class="product-grid" style="margin-top:3rem">{% for product in collection.products %}<article class="product-card"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: alt: product.title }}{% endif %}</a><div><div class="meta">{{ product.type }}</div><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="product-card-footer"><span>{{ product.price | money }}</span><a class="read-link" href="{{ product.url }}">View ↗</a></div></div></article>{% else %}<p>No products currently available.</p>{% endfor %}</div></div></section>{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
