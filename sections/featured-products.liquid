<section class="section rh-product-coming-soon">
  <div class="page-width">
    <div class="section-heading">
      <span class="eyebrow">{{ section.settings.label }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.intro }}</p>
    </div>
    {% if section.settings.collection != blank and section.settings.show_products %}
      <div class="product-grid">
        {% for product in section.settings.collection.products limit: section.settings.limit %}
          <article class="product-card">
            <a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: alt: product.title }}{% endif %}</a>
            <div><div class="meta">{{ product.type | default: 'Intelligence' }}</div><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="product-card-footer"><span>{{ product.price | money }}</span><a class="read-link" href="{{ product.url }}">View ↗</a></div></div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="rh-product-coming-soon__panel">
        <span class="eyebrow">IN DEVELOPMENT / 01</span>
        <h3>Research products are coming soon.</h3>
        <p>Join R&amp;H Intelligence to receive first access to new research products, market notes and releases.</p>
        <a class="button button--gold" href="/pages/r-h-intelligence">JOIN R&amp;H INTELLIGENCE ↗</a>
      </div>
    {% endif %}
  </div>
</section>
<style>
.rh-product-coming-soon__panel{border:1px solid var(--border);padding:clamp(2rem,6vw,6rem);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr) auto;gap:2rem;align-items:end}.rh-product-coming-soon__panel h3{font-size:clamp(2rem,4.2vw,4.5rem);line-height:.95;letter-spacing:-.055em;margin:0;font-weight:500}.rh-product-coming-soon__panel p{max-width:28rem;margin:0;line-height:1.5}.rh-product-coming-soon__panel .button{white-space:nowrap}@media(max-width:749px){.rh-product-coming-soon__panel{grid-template-columns:1fr}.rh-product-coming-soon__panel .eyebrow{grid-column:1}.rh-product-coming-soon__panel .button{justify-self:start}}
</style>
{% schema %}
{"name":"Featured products","settings":[{"type":"text","id":"label","label":"Label","default":"R&H / PRODUCTS"},{"type":"text","id":"heading","label":"Heading","default":"Research products / coming soon."},{"type":"textarea","id":"intro","label":"Introduction","default":"R&H research products are in development. Join R&H Intelligence for first access."},{"type":"checkbox","id":"show_products","label":"Show products when collection is selected","default":false},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products to show","min":3,"max":12,"step":1,"default":3}],"presets":[{"name":"Featured products"}]}
{% endschema %}
