<section class="section"><div class="page-width"><div class="section-heading"><span class="eyebrow">{{ section.settings.label }}</span><h2>{{ section.settings.heading }}</h2></div><div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.limit %}<article class="product-card"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: alt: product.title }}{% endif %}</a><div><div class="meta">{{ product.type | default: 'Intelligence' }}</div><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="product-card-footer"><span>{{ product.price | money }}</span><a class="read-link" href="{{ product.url }}">View ↗</a></div></div></article>{% else %}{% for i in (1..3) %}<article class="product-card"><span class="meta">Intelligence / 0{{ i }}</span><div><h3>Research product</h3><div class="product-card-footer"><span>From £—</span><span class="read-link">View ↗</span></div></div></article>{% endfor %}{% endfor %}</div></div></section>{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"label","label":"Label","default":"Products"},{"type":"text","id":"heading","label":"Heading","default":"Tools for independent thinking."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products to show","min":3,"max":12,"step":1,"default":3}],"presets":[{"name":"Featured products"}]}{% endschema %}
