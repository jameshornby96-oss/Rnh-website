<section class="newsletter-signup section" id="Newsletter">
  <div class="page-width newsletter-signup__inner">
    <div class="newsletter-signup__lead">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="newsletter-signup__action">
      <p>{{ section.settings.description }}</p>
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter,rh-intelligence">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
        <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Email address" autocorrect="off" autocapitalize="off" autocomplete="email" required>
        <button class="button button--gold" type="submit">{{ section.settings.button_label }} ↗</button>
        {% if form.posted_successfully? %}<p class="newsletter-form__message">You are on the list.</p>{% endif %}
        {% if form.errors %}<p class="newsletter-form__message">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{% endif %}
      {% endform %}
      <small>{{ section.settings.note }}</small>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter sign-up",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"R&H / INTELLIGENCE"},
    {"type":"text","id":"heading","label":"Heading","default":"Join our free newsletter."},
    {"type":"textarea","id":"description","label":"Description","default":"Weekly macro notes, market frameworks and the work behind the view. No noise, no charge."},
    {"type":"text","id":"button_label","label":"Button label","default":"Join free"},
    {"type":"text","id":"note","label":"Small note","default":"Free to join. Leave whenever you like."}
  ],
  "presets": [{"name":"Newsletter sign-up"}]
}
{% endschema %}
