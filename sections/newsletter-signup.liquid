<section class="newsletter-signup section" id="Newsletter">
  <div class="page-width newsletter-signup__inner">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p class="newsletter-signup__description">{{ section.settings.description }}</p>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter,rh-intelligence">
      <input type="hidden" name="contact[accepts_marketing]" value="true">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
      <div class="newsletter-signup__form">
        <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Email address" autocorrect="off" autocapitalize="off" autocomplete="email" required>
        <button type="submit">{{ section.settings.button_label }} →</button>
      </div>
      {% if form.posted_successfully? %}<p class="newsletter-signup__message" role="status">You're subscribed. R&H Intelligence will be delivered to your inbox.</p>{% endif %}
      {% if form.errors %}<p class="newsletter-signup__message" role="alert">{{ form.errors | default_errors }}</p>{% endif %}
    {% endform %}
    <p class="newsletter-signup__note">{{ section.settings.note }}</p>
  </div>
</section>
<style>
.newsletter-signup{padding:clamp(72px,12vw,160px) 0;text-align:center;border-bottom:1px solid var(--border,#25231f)}.newsletter-signup__inner{max-width:920px}.newsletter-signup h1{font-size:clamp(52px,9vw,130px);line-height:.9;letter-spacing:-.065em;margin:14px 0 26px}.newsletter-signup__description{font-size:clamp(18px,2vw,25px);max-width:650px;margin:0 auto 42px}.newsletter-signup__form{display:flex;max-width:720px;margin:auto;border:1px solid var(--foreground,#171612)}.newsletter-signup__form input{flex:1;min-width:0;border:0;background:transparent;padding:22px;font:inherit;color:inherit}.newsletter-signup__form input:focus{outline:2px solid var(--gold,#a87824);outline-offset:-2px}.newsletter-signup__form button{border:0;background:var(--foreground,#171612);color:var(--background,#ece7dc);padding:18px 28px;letter-spacing:.08em;font:inherit;text-transform:uppercase;cursor:pointer}.newsletter-signup__message{margin:16px auto 0;max-width:720px;color:var(--gold,#a87824)}.newsletter-signup__note{font-size:11px;max-width:560px;margin:20px auto 0;color:var(--muted,#59544d)}@media(max-width:600px){.newsletter-signup__form{display:block}.newsletter-signup__form input,.newsletter-signup__form button{width:100%;box-sizing:border-box}.newsletter-signup__form button{min-height:62px}}
</style>
{% schema %}
{"name":"Newsletter sign-up","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"R&H / INTELLIGENCE"},{"type":"text","id":"heading","label":"Heading","default":"R&H Intelligence"},{"type":"textarea","id":"description","label":"Description","default":"Research, market views and investment intelligence from R&H Capital."},{"type":"text","id":"button_label","label":"Button label","default":"Subscribe"},{"type":"text","id":"note","label":"Consent note","default":"By subscribing, you agree to receive R&H communications. Free to join. Leave whenever you like."}],"presets":[{"name":"Newsletter sign-up"}]}
{% endschema %}