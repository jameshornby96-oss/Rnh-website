<section class="newsletter-signup section" id="Newsletter">
  <div class="page-width newsletter-signup__inner">
    <div class="newsletter-signup__lead">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p class="newsletter-signup__description">{{ section.settings.description }}</p>
    </div>

    <div class="newsletter-signup__action">
      {% form 'customer', class: 'newsletter-form', id: 'NewsletterForm-' | append: section.id %}
        <input type="hidden" name="contact[tags]" value="newsletter,rh-intelligence">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
        <div class="newsletter-form__fields">
          <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Email address" autocorrect="off" autocapitalize="off" autocomplete="email" required aria-describedby="NewsletterNote-{{ section.id }}">
          <button class="button button--gold" type="submit">{{ section.settings.button_label }} <span aria-hidden="true">→</span></button>
        </div>
        {% if form.posted_successfully? %}
          <p class="newsletter-form__message newsletter-form__message--success" role="status">You're subscribed. R&amp;H Intelligence will be delivered to your inbox.</p>
        {% endif %}
        {% if form.errors %}
          <p class="newsletter-form__message newsletter-form__message--error" role="alert">Please enter a valid email address and try again.</p>
        {% endif %}
      {% endform %}
      <p class="newsletter-signup__note" id="NewsletterNote-{{ section.id }}">{{ section.settings.note }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter sign-up",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"R&H / INTELLIGENCE"},
    {"type":"text","id":"heading","label":"Heading","default":"R&H Intelligence"},
    {"type":"textarea","id":"description","label":"Description","default":"Research, market views and investment intelligence from R&H Capital."},
    {"type":"text","id":"button_label","label":"Button label","default":"Subscribe"},
    {"type":"text","id":"note","label":"Consent note","default":"By subscribing, you agree to receive R&H communications. Free to join. Leave whenever you like."}
  ],
  "presets": [{"name":"Newsletter sign-up"}]
}
{% endschema %}
