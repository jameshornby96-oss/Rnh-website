<header class="site-header"><div class="page-width header-inner"><a class="brand" href="{{ routes.root_url }}">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 360 | image_tag: alt: shop.name }}{% else %}{{ settings.wordmark }}{% endif %}</a><nav class="main-nav" aria-label="Primary">{% for link in linklists.main-menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav><a class="button button--gold header-cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }} ↗</a><button class="menu-button" data-menu-toggle aria-expanded="false" aria-controls="MobileNav">MENU +</button></div><nav id="MobileNav" class="mobile-nav" data-mobile-nav>{% for link in linklists.main-menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}<a class="button button--gold" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }} ↗</a></nav></header>
{% schema %}{"name":"Header","settings":[{"type":"text","id":"cta_label","label":"CTA label","default":"Join RH Intelligence"},{"type":"url","id":"cta_link","label":"CTA link"}]}{% endschema %}
