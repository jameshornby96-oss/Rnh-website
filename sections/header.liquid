{% assign intelligence_url = section.settings.cta_link | default: '/pages/r-h-intelligence' %}
<header class="site-header">
  <div class="page-width header-inner">
    <a class="brand" href="{{ routes.root_url }}">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 360 | image_tag: alt: shop.name }}<span class="brand__name">R&H Capital</span>{% else %}{{ settings.wordmark | default: 'R&H Capital' }}{% endif %}</a>
    <nav class="main-nav" aria-label="Primary">{% for link in linklists.main-menu.links %}{% unless link.handle == 'about' %}<a href="{{ link.url }}">{{ link.title }}</a>{% endunless %}{% endfor %}</nav>
    <a class="button button--gold header-cta" href="{{ intelligence_url }}">{{ section.settings.cta_label }} ↗</a>
    <button class="menu-button" data-menu-toggle aria-expanded="false" aria-controls="MobileNav">MENU +</button>
  </div>
  <nav id="MobileNav" class="mobile-nav" data-mobile-nav>{% for link in linklists.main-menu.links %}{% unless link.handle == 'about' %}<a href="{{ link.url }}">{{ link.title }}</a>{% endunless %}{% endfor %}<a class="button button--gold" href="{{ intelligence_url }}">{{ section.settings.cta_label }} ↗</a></nav>
</header>
<style>.site-header .brand{display:inline-flex;align-items:center;gap:.7rem}.site-header .brand__name{white-space:nowrap;font-size:.82rem;line-height:1;font-weight:500;letter-spacing:-.01em}</style>
{% schema %}
{"name":"Header","settings":[{"type":"text","id":"cta_label","label":"CTA label","default":"Join R&H Intelligence"},{"type":"url","id":"cta_link","label":"CTA link"}]}
{% endschema %}
