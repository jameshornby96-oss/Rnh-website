<section class="contact-email section">
  <div class="page-width">
    <p class="contact-email__intro">We’re always interested to hear your thoughts.</p>
    <a href="mailto:enquiries@rhcapital.info">enquiries@rhcapital.info</a>
    <div class="contact-email__qualities"><span>WHAT WE'RE LOOKING FOR</span><div><strong>QUANTITATIVE ANALYSIS</strong><strong>HUNGER</strong><strong>MACRO &amp; MARKETS</strong><strong>INDEPENDENT THINKING</strong></div></div>
