<style>
.contact-email{border-top:1px solid var(--border);padding-block:clamp(3rem,7vw,7rem)}
.contact-email a{font-size:clamp(1.5rem,3vw,2.5rem);letter-spacing:-.04em;color:var(--foreground);text-decoration:none;border-bottom:1px solid currentColor}
.contact-email__intro{max-width:38rem;font-size:clamp(1.1rem,2vw,1.5rem);margin:0 0 1.5rem}.contact-email__qualities{margin-top:clamp(4rem,8vw,8rem);border-top:1px solid var(--border);padding-top:1rem}.contact-email__qualities>span{font-size:.75rem;letter-spacing:.12em;color:var(--gold)}.contact-email__qualities>div{display:grid;grid-template-columns:repeat(2,1fr);gap:0;border-top:1px solid var(--border);margin-top:1rem}.contact-email__qualities strong{padding:1.25rem 0;border-bottom:1px solid var(--border);font-size:.9rem;letter-spacing:.06em}
</style>

